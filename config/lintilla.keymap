#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: homerow_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <260>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        sl_mod: sl_mod {
            compatible = "zmk,behavior-sticky-key";
            bindings = <&mo>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            ignore-modifiers;
        };

        bt_sel_0: bt_select_0 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&bt_sel 0>, <&bt_clr 0>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        bt_sel_1: bt_select_1 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&bt_sel 1>, <&bt_clr 1>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        bt_sel_2: bt_select_2 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&bt_sel 2>, <&bt_clr 2>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        bt_sel_3: bt_select_3 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&bt_sel 3>, <&bt_clr 3>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        bt_sel_4: bt_select_4 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&bt_sel 4>, <&bt_clr 4>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        out_tog: out_toggle {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&out OUT_TOG>, <&out OUT_USB>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_caps_word: u_caps_word {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&caps_word>, <&kp CAPS>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        win_ae: win_ae {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&win_ae_low>, <&win_ae_up>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        win_ie: win_ie {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&win_ie_low>, <&win_ie_up>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        win_oe: win_oe {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&win_oe_low>, <&win_oe_up>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        win_ue: win_ue {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&win_ue_low>, <&win_ue_up>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        win_agrave: win_agrave {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&win_agrave_low>, <&win_agrave_up>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        win_eaigu: win_eaigu {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&win_eaigu_low>, <&win_eaigu_up>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        win_dash: win_dash {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&win_emdash>, <&win_endash>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        new_behavior: new_behavior {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            retro-tap;
            label = "NEW_BEHAVIOR";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    macros {
        bt_sel: bt_select {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&out OUT_BLE &macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER>;
        };

        bt_clr: bt_clear {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER &bt BT_CLR>;
        };

        win_ellipsis: win_ellipsis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N3 &kp KP_N3>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_ae_low: win_ae_low {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N2 &kp KP_N8>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_ae_up: win_ae_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N9 &kp KP_N6>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_oe_low: win_oe_low {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N4 &kp KP_N6>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_oe_up: win_oe_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N1 &kp KP_N4>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_ue_low: win_ue_low {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N5 &kp KP_N2>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_ue_up: win_ue_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N2 &kp KP_N0>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_ie_low: win_ie_low {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N3 &kp KP_N9>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_ie_up: win_ie_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N0 &kp KP_N7>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_eaigu_low: win_eaigu_low {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N3 &kp KP_N3>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_eaigu_up: win_eaigu_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N0 &kp KP_N1>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_agrave_low: win_agrave_low {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N2 &kp KP_N4>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_agrave_up: win_agrave_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N9 &kp KP_N2>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_sz: win_sz {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N2 &kp KP_N3>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_ostroke: win_ostroke {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N4 &kp KP_N8>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_emdash: win_emdash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N5 &kp KP_N1>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_endash: win_endash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N5 &kp KP_N0>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_euro: win_euro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N2 &kp KP_N8>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_deg: win_deg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N7 &kp KP_N6>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_qo: win_qo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N7 &kp KP_N1>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_qc: win_qc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N8 &kp KP_N7>,
                <&macro_release>,
                <&kp LALT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_LBKT {
            bindings = <&hm LC(LSHFT) MINUS>;
            key-positions = <22 23>;
            layers = <0>;
            timeout-ms = <20>;
        };

        combo_minus {
            bindings = <&hm RCTRL LEFT_PARENTHESIS>;
            key-positions = <16 17>;
            layers = <0>;
            timeout-ms = <20>;
        };

        combo_elipse {
            bindings = <&win_ellipsis>;
            key-positions = <33 34>;
            layers = <0>;
        };

        booy {
            bindings = <&bootloader>;
            key-positions = <36 14>;
        };

        boot2 {
            bindings = <&bootloader>;
            key-positions = <41 25>;
        };

        bt_clear {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <37 14>;
        };

        bt_clear_2 {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <40 25>;
        };

        bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <5 6>;
        };

        back2layer0 {
            bindings = <&to 0>;
            key-positions = <38 39>;
        };

        to_nav {
            bindings = <&to 1>;
            key-positions = <8 9>;
        };

        close_racket {
            bindings = <&hm LC(LEFT_SHIFT) RIGHT_PARENTHESIS>;
            key-positions = <18 17>;
            timeout-ms = <20>;
            layers = <0>;
        };

        racket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 5>;
        };

        mark {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <10 11>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <21 22>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        alphas {
            bindings = <
              &tog 3                                                                                                                                                                                &tog 1
&sk LEFT_ALT  &kp Q           &kp W           &kp F        &kp P        &kp B                                                               &kp J         &kp L        &kp U        &kp Y           &kp SQT   &sl 1
&sk LCTRL     &hm LEFT_ALT A  &hm LEFT_WIN R  &hm LCTRL S  &hm LSHFT T  &kp G                                                               &kp M         &hm LSHFT N  &hm LCTRL E  &hm LEFT_WIN I  &hm O O   &sl_mod 2
              &kp Z           &kp X           &kp C        &kp D        &kp V                                                               &kp K         &kp H        &kp COMMA    &kp PERIOD      &kp FSLH
                                                                        &lt 6 ESCAPE  &lt 1 SPACE  &lt 2 TAB  &lt 4 ENTER  &lt 3 BACKSPACE  &lt 5 DELETE
            >;

            label = "Colemak-dh";
        };

        nav {
            bindings = <
       &none                                                                                                                                         &tog 1
&none  &none         &kp LG(TAB)   &kp LA(TAB)  &kp ENTER  &none                                     &kp LA(Z)   &kp LC(C)  &kp LC(V)     &kp LC(A)  &kp LC(A)  &sl 2
&none  &kp LEFT_ALT  &kp LEFT_WIN  &kp LCTRL    &kp LSHFT  &none                                     &kp LC(Z)   &kp DOWN   &kp UP_ARROW  &kp RIGHT  &kp RIGHT  &none
       &none         &none         &none        &none      &none                                     &kp HOME    &kp LEFT   &kp PG_DN     &kp PG_UP  &kp END
                                                           &none  &to 0  &none  &kp ENTER  &kp BSPC  &kp DELETE
            >;

            label = "Navigation";
        };

        Mouse {
            bindings = <
       &none                                                                                                                                                           &none
&none  &none         &none         &none      &win_ostroke  &none                                        &kp LA(F4)  &msc SCRL_DOWN  &msc SCRL_UP    &mmv MOVE_X(500)  &mmv MOVE_X(-500)  &none
&none  &kp LEFT_ALT  &kp LEFT_WIN  &kp RCTRL  &kp LSHFT     &kp SPACE                                    &mkp MB4    &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT   &mkp MB5           &none
       &win_agrave   &none         &none      &none         &none                                        &none       &mmv MOVE_LEFT  &msc SCRL_LEFT  &msc SCRL_RIGHT   &none
                                                            &none      &to 0  &none  &mkp MB2  &mkp MB1  &mkp MB3
            >;

            label = "Mouse";
        };

        num {
            bindings = <
           &tog 3                                                                                                                                            &none
&trans     &kp GRAVE         &kp N7  &kp N8  &kp N9  &kp NON_US_BACKSLASH                                         &none  &none      &none      &none         &none         &none
&sk LCTRL  &kp COLON         &kp N4  &kp N5  &kp N6  &kp EQUAL                                                    &none  &kp LSHFT  &kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &none
           &kp LEFT_BRACKET  &kp N1  &kp N2  &kp N3  &kp RIGHT_BRACKET                                            &none  &none      &none      &kp RALT      &none
                                                     &kp PERIOD            &kp NUMBER_0  &kp MINUS  &none  &to 0  &none
            >;

            label = "Numbers";
        };

        sym {
            bindings = <
       &none                                                                                                                                                   &none
&sl 4  &kp TILDE       &kp AMPS  &kp ASTRK  &kp LPAR   &kp PIPE                                                         &none  &none      &none      &none     &none     &none
&none  &kp SEMICOLON   &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS                                                         &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none
       &kp LEFT_BRACE  &kp EXCL  &kp AT     &kp HASH   &kp RIGHT_BRACE                                                  &none  &none      &none      &kp RALT  &none
                                                       &kp LPAR         &kp RIGHT_PARENTHESIS  &kp UNDER  &none  &to 0  &none
            >;

            label = "Sympols";
        };

        fun {
            bindings = <
       &none                                                                                                                              &none
&none  &kp F12  &kp F7  &kp F8  &kp F9  &kp PSCRN                                                  &none  &none      &none      &none     &none     &none
&none  &kp F11  &kp F4  &kp F5  &kp F6  &kp SLCK                                                   &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none
       &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK                                            &none  &none      &none      &kp RALT  &none
                                        &kp TAB          &kp SPC  &kp K_APPLICATION  &none  &to 0  &none
            >;

            label = "Function";
        };

        media {
            bindings = <
            &tog 7                                                                                                                                                        &none
&none       &none      &kp LA(Z)  &kp CAPSLOCK  &none     &none                                           &kp CAPS    &ind_bat           &ind_con         &bt BT_PRV      &bt BT_NXT    &none
&kp ESCAPE  &kp SPACE  &kp TAB    &kp RET       &kp BSPC  &kp DEL                                         &none       &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_PREVIOUS  &kp C_NEXT    &bt BT_SEL 4
            &to 1      &to 1      &to 2         &to 3     &kp DELETE                                      &bt BT_CLR  &bt BT_SEL 0       &bt BT_SEL 1     &bt BT_SEL 2    &bt BT_SEL 3
                                                          &none       &to 0  &none  &kp C_STOP  &kp C_PP  &kp C_MUTE
            >;

            label = "Media";
        };

        layer_7 {
            bindings = <
              &tog 7                                                                                                            &none
&kp B         &kp NUMBER_2  &kp Q  &kp X  &kp E  &kp R                                        &kp T  &kp Y  &kp U      &kp I    &kp O     &kp P
&kp NUMBER_4  &kp LSHFT     &kp A  &kp W  &kp D  &kp F                                        &kp G  &kp H  &kp J      &kp K    &kp L     &kp SEMI
              &kp NUMBER_1  &kp Z  &kp S  &kp C  &kp G                                        &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH
                                                 &kp RCTRL  &kp SPACE  &kp V  &kp TAB  &kp T  &kp Y
            >;
        };
    };
};

// vim: expandtab softtabstop=4 shiftwidth=4 filetype=dts
